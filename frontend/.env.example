# Google Maps API Key - Get from https://console.cloud.google.com/
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API URL
EXPO_PUBLIC_API_URL=https://api.isitfull.ie/api/v1

# Firebase Configuration - Get from Firebase Console
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google OAuth Client IDs - Get from Google Cloud Console
# Create OAuth 2.0 credentials for iOS, Android, and Web
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# Sentry - Get DSN from https://sentry.io/settings/projects/YOUR_PROJECT/keys/
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project

# Copy GoogleService-Info.example.plist to GoogleService-Info.plist and replace placeholders, or set GOOGLE_SERVICE_INFO_PLIST to your file path.
# Copy google-services.example.json to google-services.json and replace placeholders, or set GOOGLE_SERVICES_JSON to your file path.
