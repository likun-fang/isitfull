# ============================================
# Eco-Return Ireland - Production Environment
# ============================================
# Copy this file to .env.production and fill in all values
# DO NOT commit .env.production to git

# --- Docker Image ---
DOCKER_IMAGE=ghcr.io/likun-fang/isitfull-backend:latest

# --- Database ---
DB_USERNAME=eco_return_user
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# --- JWT ---
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_CHAR_SECRET_KEY

# --- External APIs ---
LOCATIONIQ_API_KEY=your_locationiq_api_key
GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key
# Required by application-prod.yml, although the Mapbox client is unused today
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://isitfull.ie,https://www.isitfull.ie

# --- OCI Object Storage (optional, for feedback screenshots) ---
OCI_STORAGE_ENABLED=true
OCI_AUTH_TYPE=instance_principal
OCI_REGION=uk-london-1
OCI_NAMESPACE=your_oci_namespace
OCI_BUCKET=isitfull-feedback
